{
  "name": "server",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "typeorm": "typeorm-ts-node-commonjs -d src/config/data-source.ts",
