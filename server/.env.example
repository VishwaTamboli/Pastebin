# Server port
PORT=3000
# Allowed frontend origin(s) for CORS (comma-separated in production,
# e.g. CLIENT_URL=https://app.example.com,https://admin.example.com)
CLIENT_URL=http://localhost:5173

# Rate limiting for paste endpoints (in-memory, per IP)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=10

# PostgreSQL connection (TypeORM, synchronize is disabled in code)
# Adjust these to match your local PostgreSQL role and password.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=pastebin
