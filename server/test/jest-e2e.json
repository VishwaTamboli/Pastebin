{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "roots": ["<rootDir>"],
  "testMatch": ["**/*.e2e-spec.ts"],
  "testTimeout": 60000,
  "transform": {
    "^.+\\.[tj]sx?$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.e2e.json" }]
  },
  "transformIgnorePatterns": ["node_modules/(?!@nestjs/schedule/)"]
}
